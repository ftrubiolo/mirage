    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "chokidar": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "npm:@janhapke/sharp-electron@^0.35.4-electron.1",
    "three": "^0.184.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.3"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.4"
  },
